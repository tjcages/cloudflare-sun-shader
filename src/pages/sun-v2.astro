---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import { AccentShaderV2 } from "../components/accent-shader-v2";
import { ShaderDevRoot } from "shader-panel";
---

<Layout title="Sun Shader v2">
  <Nav current="sun-v2" />
  <main class="shader-stage">
    <AccentShaderV2 client:load className="shader-fullscreen" />
  </main>
  <ShaderDevRoot client:load defaultTheme="light" />

  <style>
    .shader-stage {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100dvh;
      background: #ff5e1f;
      overflow: hidden;
      isolation: isolate;
    }

    :global(.shader-fullscreen) {
      position: absolute !important;
      inset: 0 !important;
    }
  </style>
</Layout>
