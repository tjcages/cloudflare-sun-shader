---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import { ComboShader } from "../components/combo-shader";
import { ShaderDevRoot } from "shader-panel";
---

<Layout title="Combo Shader">
  <Nav current="combo" />
  <main class="combo-stage">
    <ComboShader client:only="react" className="shader-fullscreen" />
  </main>
  <ShaderDevRoot client:load defaultTheme="light" />

  <style>
    .combo-stage {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100dvh;
      background: #ff5e1f;
      overflow: hidden;
      isolation: isolate;
    }

    :global(.shader-fullscreen) {
      position: absolute !important;
      inset: 0 !important;
    }
  </style>
</Layout>
