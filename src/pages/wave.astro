---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import { WaveShader } from "../components/wave-shader";
---

<Layout title="Wave Shader">
  <Nav current="wave" />
  <main class="wave-stage">
    <WaveShader client:only="react" className="shader-fullscreen" />
  </main>
  {/* No <ShaderDevRoot/> — useShaderDev injects the panel itself. */}

  <style>
    .wave-stage {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100dvh;
      background: #0b0b14;
      overflow: hidden;
      isolation: isolate;
    }

    :global(.shader-fullscreen) {
      position: absolute !important;
      inset: 0 !important;
    }
  </style>
</Layout>
