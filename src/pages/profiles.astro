---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import { ProfilesShader } from "../components/profiles-shader";
---

<Layout title="Profile Relight">
  <Nav current="profiles" />
  <main class="profiles-stage">
    <ProfilesShader client:only="react" className="shader-fullscreen" />
  </main>
  {/* No <ShaderDevRoot/> — useShaderDev injects the panel itself. */}

  <style>
    .profiles-stage {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100dvh;
      background: #050507;
      overflow: hidden;
      isolation: isolate;
    }

    :global(.shader-fullscreen) {
      position: absolute !important;
      inset: 0 !important;
    }

    :global(.profiles-status) {
      position: fixed;
      bottom: 1rem;
      left: 1rem;
      z-index: 60;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 14px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.15);
      background: rgba(0, 0, 0, 0.55);
      color: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        sans-serif;
      font-size: 12px;
      letter-spacing: 0.02em;
    }

    :global(.profiles-status-dot) {
      width: 6px;
      height: 6px;
      border-radius: 999px;
      background: #ff5e1f;
      animation: profiles-pulse 1.2s ease-in-out infinite;
    }

    @keyframes profiles-pulse {
      0%,
      100% {
        opacity: 1;
        transform: scale(1);
      }
      50% {
        opacity: 0.4;
        transform: scale(0.8);
      }
    }

    :global(.profiles-dropzone) {
      position: fixed;
      inset: 12px;
      z-index: 65;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2px dashed rgba(255, 255, 255, 0.4);
      border-radius: 16px;
      background: rgba(0, 0, 0, 0.45);
      color: #fff;
      font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        sans-serif;
      font-size: 15px;
      letter-spacing: 0.04em;
      pointer-events: none;
    }

    :global(.portrait-editor-backdrop) {
      position: fixed;
      inset: 0;
      z-index: 200;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      background: rgba(0, 0, 0, 0.72);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      opacity: 0;
      transition-property: opacity;
      transition-duration: 220ms;
      transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
      -webkit-font-smoothing: antialiased;
    }

    :global(.portrait-editor-backdrop.is-active) {
      opacity: 1;
    }

    :global(.portrait-editor-backdrop:not(.is-active)) {
      transition-duration: 150ms;
      transition-timing-function: ease-in;
    }

    :global(.portrait-editor) {
      display: flex;
      flex-direction: column;
      width: min(1400px, calc(100vw - 48px));
      max-height: calc(100dvh - 48px);
      border-radius: 16px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      background: #0d0d10;
      color: #fff;
      overflow: hidden;
      box-shadow: 0 24px 80px rgba(0, 0, 0, 0.55);
      font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        sans-serif;
      opacity: 0;
      transform: translateY(12px) scale(0.98);
      filter: blur(4px);
      transition-property: opacity, transform, filter;
      transition-duration: 320ms;
      transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }

    :global(.portrait-editor-backdrop.is-active .portrait-editor) {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }

    :global(.portrait-editor-backdrop:not(.is-active) .portrait-editor) {
      transition-duration: 150ms;
      transition-timing-function: ease-in;
    }

    :global(.portrait-editor-header),
    :global(.portrait-editor-body),
    :global(.portrait-editor-footer) {
      opacity: 0;
      transform: translateY(8px);
      transition-property: opacity, transform;
      transition-duration: 300ms;
      transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }

    :global(.portrait-editor-backdrop.is-active .portrait-editor-header) {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 40ms;
    }

    :global(.portrait-editor-backdrop.is-active .portrait-editor-body) {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 100ms;
    }

    :global(.portrait-editor-backdrop.is-active .portrait-editor-footer) {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 160ms;
    }

    :global(.portrait-editor-backdrop:not(.is-active) .portrait-editor-header),
    :global(.portrait-editor-backdrop:not(.is-active) .portrait-editor-body),
    :global(.portrait-editor-backdrop:not(.is-active) .portrait-editor-footer) {
      transition-delay: 0ms;
      transition-duration: 120ms;
    }

    @media (prefers-reduced-motion: reduce) {
      :global(.portrait-editor-backdrop),
      :global(.portrait-editor),
      :global(.portrait-editor-header),
      :global(.portrait-editor-body),
      :global(.portrait-editor-footer) {
        transition: none !important;
        opacity: 1 !important;
        transform: none !important;
        filter: none !important;
      }
    }

    :global(.portrait-editor-header) {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      padding: 20px 24px 12px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    :global(.portrait-editor-title) {
      margin: 0;
      font-size: 18px;
      font-weight: 600;
      letter-spacing: -0.01em;
      text-wrap: balance;
    }

    :global(.portrait-editor-subtitle) {
      margin: 6px 0 0;
      font-size: 13px;
      line-height: 1.45;
      color: rgba(255, 255, 255, 0.62);
      max-width: 52ch;
      text-wrap: pretty;
    }

    :global(.portrait-editor-close) {
      position: relative;
      flex-shrink: 0;
      display: grid;
      place-items: center;
      width: 32px;
      height: 32px;
      padding: 0;
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.05);
      color: rgba(255, 255, 255, 0.8);
      cursor: pointer;
      transition-property: background-color, color, scale;
      transition-duration: 150ms;
      transition-timing-function: ease-out;
    }

    :global(.portrait-editor-close::before) {
      content: "";
      position: absolute;
      inset: -4px;
    }

    :global(.portrait-editor-close:active) {
      scale: 0.96;
    }

    :global(.portrait-editor-close-icon) {
      display: block;
    }

    :global(.portrait-editor-close:hover) {
      background: rgba(255, 255, 255, 0.1);
      color: #fff;
    }

    :global(.portrait-editor-body) {
      display: grid;
      grid-template-columns: 1fr 320px;
      gap: 0;
      min-height: 0;
      flex: 1;
      overflow: hidden;
    }

    @media (max-width: 960px) {
      :global(.portrait-editor-body) {
        grid-template-columns: 1fr;
        overflow-y: auto;
      }
    }

    :global(.portrait-editor-preview) {
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding: 16px 20px 20px;
      min-width: 0;
    }

    :global(.portrait-editor-preview-tabs) {
      display: flex;
      gap: 6px;
    }

    :global(.portrait-editor-tab) {
      padding: 6px 12px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: transparent;
      color: rgba(255, 255, 255, 0.65);
      font-size: 12px;
      cursor: pointer;
    }

    :global(.portrait-editor-tab.is-active) {
      background: rgba(255, 94, 31, 0.15);
      border-color: rgba(255, 94, 31, 0.45);
      color: #ff8a57;
    }

    :global(.portrait-editor-canvas) {
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
      min-height: 320px;
      flex: 1;
    }

    :global(.portrait-editor-canvas.is-split) {
      grid-template-columns: 1fr 1fr;
    }

    :global(.portrait-editor-pane) {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 280px;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.03);
      overflow: hidden;
    }

    :global(.portrait-editor-pane-label) {
      position: absolute;
      top: 10px;
      left: 10px;
      z-index: 1;
      padding: 4px 10px;
      border-radius: 999px;
      background: rgba(0, 0, 0, 0.55);
      font-size: 11px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.75);
    }

    :global(.portrait-editor-img) {
      max-width: 92%;
      max-height: 92%;
      object-fit: contain;
      border-radius: 4px;
      outline: 1px solid rgba(255, 255, 255, 0.1);
      outline-offset: -1px;
    }

    :global(.portrait-editor-placeholder) {
      font-size: 13px;
      color: rgba(255, 255, 255, 0.5);
    }

    :global(.portrait-editor-face-hint) {
      margin: 0;
      font-size: 12px;
      color: rgba(255, 255, 255, 0.5);
    }

    :global(.portrait-editor-controls) {
      display: flex;
      flex-direction: column;
      gap: 16px;
      padding: 16px 18px 20px;
      border-left: 1px solid rgba(255, 255, 255, 0.08);
      overflow-y: auto;
    }

    @media (max-width: 860px) {
      :global(.portrait-editor-controls) {
        border-left: none;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
      }
    }

    :global(.portrait-editor-section) {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    :global(.portrait-editor-section-title) {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.45);
    }

    :global(.portrait-editor-generate) {
      width: 100%;
    }

    :global(.portrait-editor-section-hint) {
      margin: -4px 0 0;
      font-size: 11px;
      line-height: 1.45;
      color: rgba(255, 255, 255, 0.38);
    }

    :global(.portrait-editor-presets) {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    :global(.portrait-editor-bg-swatches) {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 10px;
    }

    :global(.portrait-editor-bg-swatch) {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 10px;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.04);
      color: rgba(255, 255, 255, 0.78);
      font-size: 12px;
      cursor: pointer;
      transition:
        border-color 140ms ease,
        background-color 140ms ease;
    }

    :global(.portrait-editor-bg-swatch.is-active) {
      border-color: rgba(255, 94, 31, 0.55);
      background: rgba(255, 94, 31, 0.12);
    }

    :global(.portrait-editor-bg-swatch-chip) {
      width: 14px;
      height: 14px;
      border-radius: 4px;
      border: 1px solid rgba(255, 255, 255, 0.2);
      flex-shrink: 0;
    }

    :global(.portrait-editor-preset) {
      padding: 6px 10px;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: rgba(255, 255, 255, 0.04);
      color: rgba(255, 255, 255, 0.75);
      font-size: 12px;
      cursor: pointer;
    }

    :global(.portrait-editor-preset.is-active) {
      border-color: rgba(255, 94, 31, 0.5);
      background: rgba(255, 94, 31, 0.12);
      color: #ff9a6a;
    }

    :global(.portrait-editor-compositions) {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    :global(.portrait-editor-composition) {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 3px;
      width: 100%;
      padding: 8px 10px;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: rgba(255, 255, 255, 0.04);
      color: rgba(255, 255, 255, 0.75);
      text-align: left;
      cursor: pointer;
    }

    :global(.portrait-editor-composition.is-active) {
      border-color: rgba(255, 94, 31, 0.5);
      background: rgba(255, 94, 31, 0.1);
    }

    :global(.portrait-editor-composition-label) {
      font-size: 12px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.9);
    }

    :global(.portrait-editor-composition.is-active .portrait-editor-composition-label) {
      color: #ff9a6a;
    }

    :global(.portrait-editor-composition-desc) {
      font-size: 10.5px;
      line-height: 1.35;
      color: rgba(255, 255, 255, 0.48);
    }

    :global(.portrait-editor-toggle) {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: rgba(255, 255, 255, 0.8);
      cursor: pointer;
    }

    :global(.portrait-editor-color) {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 13px;
      color: rgba(255, 255, 255, 0.8);
    }

    :global(.portrait-editor-color input[type="color"]) {
      width: 36px;
      height: 28px;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 6px;
      background: transparent;
      cursor: pointer;
    }

    :global(.portrait-editor-slider) {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    :global(.portrait-editor-slider-label) {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      color: rgba(255, 255, 255, 0.72);
    }

    :global(.portrait-editor-slider-value) {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-variant-numeric: tabular-nums;
      color: rgba(255, 255, 255, 0.45);
    }

    :global(.portrait-editor-footer) {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 14px 20px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(255, 255, 255, 0.02);
      flex-wrap: nowrap;
    }

    :global(.portrait-editor-status) {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      color: rgba(255, 255, 255, 0.7);
      min-width: 0;
    }

    :global(.portrait-editor-error-badge) {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 6px 12px;
      border-radius: 999px;
      border: 1px solid rgba(255, 80, 60, 0.45);
      background: rgba(255, 60, 40, 0.12);
      color: #ff8a7a;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.02em;
      cursor: default;
      flex-shrink: 0;
    }

    :global(.portrait-editor-error-badge.is-open .portrait-editor-error-tooltip) {
      display: flex;
    }

    :global(.portrait-editor-error-dot) {
      width: 6px;
      height: 6px;
      border-radius: 999px;
      background: #ff5e4a;
      flex-shrink: 0;
    }

    :global(.portrait-editor-error-tooltip) {
      position: absolute;
      bottom: calc(100% + 4px);
      left: 0;
      z-index: 20;
      display: none;
      flex-direction: column;
      gap: 8px;
      width: max-content;
      max-width: min(420px, 70vw);
      padding: 10px 12px;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      background: rgba(12, 12, 16, 0.98);
      color: rgba(255, 255, 255, 0.88);
      font-size: 11.5px;
      font-weight: 400;
      line-height: 1.45;
      white-space: normal;
      word-break: break-word;
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
      pointer-events: auto;
    }

    /* Invisible hover bridge between badge and tooltip */
    :global(.portrait-editor-error-tooltip::after) {
      content: "";
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      height: 8px;
    }

    :global(.portrait-editor-error-message) {
      margin: 0;
    }

    :global(.portrait-editor-error-copy) {
      align-self: flex-start;
      padding: 4px 8px;
      border-radius: 6px;
      border: 1px solid rgba(255, 255, 255, 0.16);
      background: rgba(255, 255, 255, 0.06);
      color: rgba(255, 255, 255, 0.82);
      font-size: 11px;
      cursor: pointer;
    }

    :global(.portrait-editor-error-copy:hover) {
      background: rgba(255, 255, 255, 0.12);
      color: #fff;
    }

    :global(.portrait-editor-footer-hint) {
      font-size: 12px;
      color: rgba(255, 255, 255, 0.45);
      min-width: 0;
    }

    :global(.portrait-editor-actions) {
      display: flex;
      gap: 8px;
      margin-left: auto;
      flex-shrink: 0;
    }

    :global(.portrait-editor-btn) {
      padding: 8px 14px;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      background: rgba(255, 255, 255, 0.05);
      color: rgba(255, 255, 255, 0.8);
      font-size: 13px;
      cursor: pointer;
      white-space: nowrap;
      transition-property: background-color, color, filter, scale;
      transition-duration: 150ms;
      transition-timing-function: ease-out;
    }

    :global(.portrait-editor-btn:active:not(:disabled)) {
      scale: 0.96;
    }

    :global(.portrait-editor-btn:hover:not(:disabled)) {
      background: rgba(255, 255, 255, 0.1);
      color: #fff;
    }

    :global(.portrait-editor-btn:disabled) {
      opacity: 0.45;
      cursor: not-allowed;
    }

    :global(.portrait-editor-btn-primary) {
      background: #ff5e1f;
      border-color: transparent;
      color: #fff;
    }

    :global(.portrait-editor-btn-primary:hover:not(:disabled)) {
      filter: brightness(1.08);
    }

    :global(.portrait-editor-btn-primary:active:not(:disabled)) {
      filter: brightness(1.08);
    }

    /* Fade the dev panel out while studio is open — keeps slide/fade exit visible */
    :global(body.portrait-studio-active [data-shader-dev]),
    :global(body.portrait-studio-active .sd-edge-sensor) {
      opacity: 0 !important;
      pointer-events: none !important;
    }
  </style>
</Layout>
