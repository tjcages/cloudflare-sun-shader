---
import Layout from "../layouts/Layout.astro";
import { AccentShader } from "../components/accent-shader";
---

<Layout title="Cloudflare Sun Shader">
  <main class="shader-stage">
    <AccentShader client:load className="shader-fullscreen" />
  </main>

  <style>
    .shader-stage {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100dvh;
      background: #ff5e1f;
      overflow: hidden;
      isolation: isolate;
    }

    :global(.shader-fullscreen) {
      position: absolute !important;
      inset: 0 !important;
    }
  </style>
</Layout>
